  deleted_at timestamp [note: 'لا حذف فعلي — FR-AUTH-007/030']
}

Table verification_codes [headercolor: #1F2937, note: 'FR-AUTH-010/011 — رموز التحقق واستعادة كلمة المرور'] {
  id "bigint unsigned" [pk, not null]
  user_id "bigint unsigned"
  channel varchar(10) [not null, note: 'email | sms | whatsapp']
  destination varchar(255) [not null, note: 'البريد/الهاتف وقت الإرسال']
  purpose varchar(30) [not null, note: 'email_verification | phone_verification | password_reset | mfa_login | contact_change']
  code_hash varchar(255) [not null]
  attempts "smallint unsigned" [not null]
  max_attempts "smallint unsigned" [not null]
  expires_at timestamp [not null]
  consumed_at timestamp
  ip_address varchar(45)
  created_at timestamp [not null]
}

