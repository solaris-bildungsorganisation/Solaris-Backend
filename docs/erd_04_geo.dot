digraph ERD {
graph [rankdir=LR, newrank=true, splines=true, nodesep=0.4, ranksep=0.8, fontname="Helvetica", fontsize=18, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [color="#6B7280", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.0];
subgraph cluster_0 { label="Geo & Region policy"; style="rounded,filled"; fillcolor="#E3F2FD"; color="#9CA3AF";
"countries" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>countries</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="iso2">iso2 *</td><td align="left"><font color="#6B7280">char(2)</font></td></tr><tr><td align="left" port="iso3">iso3</td><td align="left"><font color="#6B7280">char(3)</font></td></tr><tr><td align="left" port="name">name *</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="phone_code">phone_code</td><td align="left"><font color="#6B7280">varchar(8)</font></td></tr><tr><td align="left" port="default_language_id"><i>FK default_language_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="policy_group">policy_group *</td><td align="left"><font color="#6B7280">varchar(30)</font></td></tr><tr><td align="left" port="is_active">is_active *</td><td align="left"><font color="#6B7280">boolean</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
"regions" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>regions</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="country_id"><i>FK country_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="parent_id"><i>FK parent_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="type">type *</td><td align="left"><font color="#6B7280">varchar(30)</font></td></tr><tr><td align="left" port="code">code</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="name">name *</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="is_active">is_active *</td><td align="left"><font color="#6B7280">boolean</font></td></tr><tr><td align="left" port="sort_order">sort_order *</td><td align="left"><font color="#6B7280">smallint unsigned</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
"region_policies" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>region_policies</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="policy_key">policy_key *</td><td align="left"><font color="#6B7280">varchar(80)</font></td></tr><tr><td align="left" port="country_id"><i>FK country_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="region_id"><i>FK region_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="value">value *</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="is_active">is_active *</td><td align="left"><font color="#6B7280">boolean</font></td></tr><tr><td align="left" port="effective_from">effective_from</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="effective_to">effective_to</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="created_by"><font color="#9CA3AF">FK created_by</font></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="updated_by"><font color="#9CA3AF">FK updated_by</font></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="scope_key">scope_key</td><td align="left"><font color="#6B7280">varchar(120) (virtual)</font></td></tr></table>>];
"user_region_changes" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>user_region_changes</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="user_id"><i>FK user_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="old_country_id"><i>FK old_country_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="old_region_id"><i>FK old_region_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="new_country_id"><i>FK new_country_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="new_region_id"><i>FK new_region_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="reason">reason</td><td align="left"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="status">status *</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="requested_by"><font color="#9CA3AF">FK requested_by</font></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="reviewed_by"><font color="#9CA3AF">FK reviewed_by</font></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="reviewed_at">reviewed_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
}
"languages" -> "countries":"default_language_id" [label="default_language_id", fontsize=8, fontcolor="#6B7280"];
"countries":"id" -> "region_policies":"country_id" [label="country_id", fontsize=8, fontcolor="#6B7280"];
"regions":"id" -> "region_policies":"region_id" [label="region_id", fontsize=8, fontcolor="#6B7280"];
"countries":"id" -> "regions":"country_id" [label="country_id", fontsize=8, fontcolor="#6B7280"];
"regions":"id" -> "regions":"parent_id" [label="parent_id", fontsize=8, fontcolor="#6B7280"];
"countries":"id" -> "user_region_changes":"new_country_id" [label="new_country_id", fontsize=8, fontcolor="#6B7280"];
"regions":"id" -> "user_region_changes":"new_region_id" [label="new_region_id", fontsize=8, fontcolor="#6B7280"];
"countries":"id" -> "user_region_changes":"old_country_id" [label="old_country_id", fontsize=8, fontcolor="#6B7280"];
"regions":"id" -> "user_region_changes":"old_region_id" [label="old_region_id", fontsize=8, fontcolor="#6B7280"];
"users" -> "user_region_changes":"user_id" [label="user_id", fontsize=8, fontcolor="#6B7280"];
"languages" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#6B7280"><font color="white"><b>languages</b></font></td></tr></table>>];
"users" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#6B7280"><font color="white"><b>users</b></font></td></tr></table>>];
}