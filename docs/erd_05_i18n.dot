digraph ERD {
graph [rankdir=LR, newrank=true, splines=true, nodesep=0.4, ranksep=0.8, fontname="Helvetica", fontsize=18, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [color="#6B7280", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.0];
subgraph cluster_0 { label="I18N"; style="rounded,filled"; fillcolor="#E0F2F1"; color="#9CA3AF";
"languages" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>languages</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="code">code *</td><td align="left"><font color="#6B7280">varchar(10)</font></td></tr><tr><td align="left" port="name">name *</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="native_name">native_name *</td><td align="left"><font color="#6B7280">varchar(100)</font></td></tr><tr><td align="left" port="direction">direction *</td><td align="left"><font color="#6B7280">varchar(3)</font></td></tr><tr><td align="left" port="is_interface">is_interface *</td><td align="left"><font color="#6B7280">boolean</font></td></tr><tr><td align="left" port="is_content">is_content *</td><td align="left"><font color="#6B7280">boolean</font></td></tr><tr><td align="left" port="is_active">is_active *</td><td align="left"><font color="#6B7280">boolean</font></td></tr><tr><td align="left" port="sort_order">sort_order *</td><td align="left"><font color="#6B7280">smallint unsigned</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
"user_languages" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>user_languages</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="user_id"><i>FK user_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="language_id"><i>FK language_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="proficiency">proficiency *</td><td align="left"><font color="#6B7280">varchar(10)</font></td></tr><tr><td align="left" port="is_native">is_native *</td><td align="left"><font color="#6B7280">boolean</font></td></tr><tr><td align="left" port="source">source *</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="verified_at">verified_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
"language_requirements" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>language_requirements</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="requirable_type">requirable_type *</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="requirable_id">requirable_id *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="language_id"><i>FK language_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="min_proficiency">min_proficiency</td><td align="left"><font color="#6B7280">varchar(10)</font></td></tr><tr><td align="left" port="is_mandatory">is_mandatory *</td><td align="left"><font color="#6B7280">boolean</font></td></tr><tr><td align="left" port="purpose">purpose *</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
"ui_translations" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>ui_translations</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="group">group *</td><td align="left"><font color="#6B7280">varchar(50)</font></td></tr><tr><td align="left" port="key">key *</td><td align="left"><font color="#6B7280">varchar(150)</font></td></tr><tr><td align="left" port="language_id"><i>FK language_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="value">value *</td><td align="left"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="updated_by"><font color="#9CA3AF">FK updated_by</font></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
}
"languages":"id" -> "language_requirements":"language_id" [label="language_id", fontsize=8, fontcolor="#6B7280"];
"languages":"id" -> "ui_translations":"language_id" [label="language_id", fontsize=8, fontcolor="#6B7280"];
"languages":"id" -> "user_languages":"language_id" [label="language_id", fontsize=8, fontcolor="#6B7280"];
"users" -> "user_languages":"user_id" [label="user_id", fontsize=8, fontcolor="#6B7280"];
"users" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#6B7280"><font color="white"><b>users</b></font></td></tr></table>>];
}