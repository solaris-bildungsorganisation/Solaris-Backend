digraph ERD {
graph [rankdir=LR, newrank=true, splines=true, nodesep=0.4, ranksep=0.8, fontname="Helvetica", fontsize=18, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [color="#6B7280", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.0];
subgraph cluster_0 { label="Identity"; style="rounded,filled"; fillcolor="#FDECEA"; color="#9CA3AF";
"users" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>users</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="uuid">uuid *</td><td align="left"><font color="#6B7280">char(36)</font></td></tr><tr><td align="left" port="first_name">first_name *</td><td align="left"><font color="#6B7280">varchar(100)</font></td></tr><tr><td align="left" port="last_name">last_name *</td><td align="left"><font color="#6B7280">varchar(100)</font></td></tr><tr><td align="left" port="display_name">display_name</td><td align="left"><font color="#6B7280">varchar(150)</font></td></tr><tr><td align="left" port="email">email</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="phone">phone</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="password">password *</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="avatar_path">avatar_path</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="birth_date">birth_date</td><td align="left"><font color="#6B7280">date</font></td></tr><tr><td align="left" port="status">status *</td><td align="left"><font color="#6B7280">varchar(30)</font></td></tr><tr><td align="left" port="status_changed_at">status_changed_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="email_verified_at">email_verified_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="phone_verified_at">phone_verified_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="interface_language_id"><i>FK interface_language_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="country_id"><i>FK country_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="region_id"><i>FK region_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="timezone">timezone *</td><td align="left"><font color="#6B7280">varchar(64)</font></td></tr><tr><td align="left" port="two_factor_secret">two_factor_secret</td><td align="left"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="two_factor_recovery_codes">two_factor_recovery_codes</td><td align="left"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="two_factor_confirmed_at">two_factor_confirmed_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="password_changed_at">password_changed_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="must_change_password">must_change_password *</td><td align="left"><font color="#6B7280">boolean</font></td></tr><tr><td align="left" port="failed_login_count">failed_login_count *</td><td align="left"><font color="#6B7280">smallint unsigned</font></td></tr><tr><td align="left" port="locked_until">locked_until</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="last_login_at">last_login_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="last_login_ip">last_login_ip</td><td align="left"><font color="#6B7280">varchar(45)</font></td></tr><tr><td align="left" port="created_by"><font color="#9CA3AF">FK created_by</font></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="deleted_at">deleted_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
"password_histories" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>password_histories</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="user_id"><i>FK user_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="password_hash">password_hash *</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="created_at">created_at *</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
"account_status_histories" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>account_status_histories</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="user_id"><i>FK user_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="from_status">from_status</td><td align="left"><font color="#6B7280">varchar(30)</font></td></tr><tr><td align="left" port="to_status">to_status *</td><td align="left"><font color="#6B7280">varchar(30)</font></td></tr><tr><td align="left" port="reason">reason</td><td align="left"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="changed_by"><font color="#9CA3AF">FK changed_by</font></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="created_at">created_at *</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
}
"users":"id" -> "account_status_histories":"user_id" [label="user_id", fontsize=8, fontcolor="#6B7280"];
"users":"id" -> "password_histories":"user_id" [label="user_id", fontsize=8, fontcolor="#6B7280"];
"countries" -> "users":"country_id" [label="country_id", fontsize=8, fontcolor="#6B7280"];
"languages" -> "users":"interface_language_id" [label="interface_language_id", fontsize=8, fontcolor="#6B7280"];
"regions" -> "users":"region_id" [label="region_id", fontsize=8, fontcolor="#6B7280"];
"countries" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#6B7280"><font color="white"><b>countries</b></font></td></tr></table>>];
"languages" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#6B7280"><font color="white"><b>languages</b></font></td></tr></table>>];
"regions" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#6B7280"><font color="white"><b>regions</b></font></td></tr></table>>];
}