"user_contexts" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>user_contexts</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="user_id"><i>FK user_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="context_id"><i>FK context_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="status">status *</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="is_default">is_default *</td><td align="left"><font color="#6B7280">boolean</font></td></tr><tr><td align="left" port="activated_at">activated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="deactivated_at">deactivated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="granted_by"><font color="#9CA3AF">FK granted_by</font></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="default_user_key">default_user_key</td><td align="left"><font color="#6B7280">bigint unsigned (virtual)</font></td></tr></table>>];
