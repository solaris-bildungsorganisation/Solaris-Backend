digraph ERD {
graph [rankdir=LR, newrank=true, splines=true, nodesep=0.4, ranksep=0.8, fontname="Helvetica", fontsize=18, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [color="#6B7280", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.0];
subgraph cluster_0 { label="RBAC"; style="rounded,filled"; fillcolor="#FFF4DE"; color="#9CA3AF";
"contexts" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>contexts</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="key">key *</td><td align="left"><font color="#6B7280">varchar(50)</font></td></tr><tr><td align="left" port="name">name *</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="is_active">is_active *</td><td align="left"><font color="#6B7280">boolean</font></td></tr><tr><td align="left" port="sort_order">sort_order *</td><td align="left"><font color="#6B7280">smallint unsigned</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
