"success_stories" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>success_stories</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="uuid">uuid *</td><td align="left"><font color="#6B7280">char(36)</font></td></tr><tr><td align="left" port="title">title *</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="summary">summary</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="body">body *</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="subject_user_id"><i>FK subject_user_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="organization_id"><i>FK organization_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="country_id"><i>FK country_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="region_id"><i>FK region_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="consent_status">consent_status *</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="consent_recorded_at">consent_recorded_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="consent_recorded_by"><font color="#9CA3AF">FK consent_recorded_by</font></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="status">status *</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="published_at">published_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port=