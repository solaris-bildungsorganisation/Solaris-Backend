digraph ERD {
graph [rankdir=LR, newrank=true, splines=true, nodesep=0.4, ranksep=0.8, fontname="Helvetica", fontsize=18, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [color="#6B7280", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.0];
subgraph cluster_0 { label="ADMIN & Audit"; style="rounded,filled"; fillcolor="#F3F4F6"; color="#9CA3AF";
"activity_log" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>activity_log</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="log_name">log_name</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="description">description *</td><td align="left"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="subject_type">subject_type</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="subject_id">subject_id</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="event">event</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="causer_type">causer_type</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="causer_id">causer_id</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="properties">properties</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="batch_uuid">batch_uuid</td><td align="left"><font color="#6B7280">char(36)</font></td></tr><tr><td align="left" port="session_id">session_id</td><td align="left"><font color="#6B7280">char(36)</font></td></tr><tr><td align="left" port="context_id"><i>FK context_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="organization_id"><i>FK organization_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="sensitivity">sensitivity *</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="ip_address">ip_address</td><td align="left"><font color="#6B7280">varchar(45)</font></td></tr><tr><td align="left" port="user_agent">user_agent</td><td align="left"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
"metric_snapshots" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>metric_snapshots</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="metric_key">metric_key *</td><td align="left"><font color="#6B7280">varchar(80)</font></td></tr><tr><td align="left" port="period_type">period_type *</td><td align="left"><font color="#6B7280">varchar(10)</font></td></tr><tr><td align="left" port="period_start">period_start *</td><td align="left"><font color="#6B7280">date</font></td></tr><tr><td align="left" port="period_end">period_end *</td><td align="left"><font color="#6B7280">date</font></td></tr><tr><td align="left" port="country_id"><i>FK country_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="region_id"><i>FK region_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="organization_id"><i>FK organization_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="dimensions">dimensions *</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="dimensions_hash">dimensions_hash *</td><td align="left"><font color="#6B7280">varchar(64)</font></td></tr><tr><td align="left" port="value">value *</td><td align="left"><font color="#6B7280">decimal(18,4)</font></td></tr><tr><td align="left" port="computed_at">computed_at *</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="snapshot_key">snapshot_key</td><td align="left"><font color="#6B7280">varchar(255) (virtual)</font></td></tr></table>>];
"report_exports" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>report_exports</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="uuid">uuid *</td><td align="left"><font color="#6B7280">char(36)</font></td></tr><tr><td align="left" port="user_id"><i>FK user_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="report_key">report_key *</td><td align="left"><font color="#6B7280">varchar(80)</font></td></tr><tr><td align="left" port="filters">filters *</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="format">format *</td><td align="left"><font color="#6B7280">varchar(10)</font></td></tr><tr><td align="left" port="status">status *</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="file_path">file_path</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="row_count">row_count</td><td align="left"><font color="#6B7280">int unsigned</font></td></tr><tr><td align="left" port="error">error</td><td align="left"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="context_id"><i>FK context_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="organization_id"><i>FK organization_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="completed_at">completed_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="expires_at">expires_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><t