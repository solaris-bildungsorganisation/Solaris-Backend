digraph ERD {
graph [rankdir=LR, newrank=true, splines=true, nodesep=0.4, ranksep=0.8, fontname="Helvetica", fontsize=18, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [color="#6B7280", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.0];
subgraph cluster_0 { label="Sessions & Security"; style="rounded,filled"; fillcolor="#EDE7F6"; color="#9CA3AF";
"personal_access_tokens" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>personal_access_tokens</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="tokenable_type">tokenable_type *</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="tokenable_id">tokenable_id *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="name">name *</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="token">token *</td><td align="left"><font color="#6B7280">varchar(64)</font></td></tr><tr><td align="left" port="abilities">abilities</td><td align="left"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="last_used_at">last_used_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="expires_at">expires_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
"user_sessions" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>user_sessions</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">char(36)</font></td></tr><tr><td align="left" port="user_id"><i>FK user_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="personal_access_token_id"><i>FK personal_access_token_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="active_context_id"><i>FK active_context_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="active_scope_id"><i>FK active_scope_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="device_name">device_name</td><td align="left"><font color="#6B7280">varchar(150)</font></td></tr><tr><td align="left" port="platform">platform</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="ip_address">ip_address</td><td align="left"><font color="#6B7280">varchar(45)</font></td></tr><tr><td align="left" port="user_agent">user_agent</td><td align="left"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="last_activity_at">last_activity_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="expires_at">expires_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="revoked_at">revoked_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="revoked_by"><font color="#9CA3AF">FK revoked_by</font></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="revoke_reason">revoke_reason</td><td align="left"><font color="#6B7280">varchar(30)</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
"verification_codes" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>verification_codes</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="user_id"><i>FK user_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="channel">channel *</td><td align="left"><font color="#6B7280">varchar(10)</font></td></tr><tr><td align="left" port="destination">destination *</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="purpose">purpose *</td><td align="left"><font color="#6B7280">varchar(30)</font></td></tr><tr><td align="left" port="code_hash">code_hash *</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="attempts">attempts *</td><td align="left"><font color="#6B7280">smallint unsigned</font></td></tr><tr><td align="left" port="max_attempts">max_attempts *</td><td align="left"><font color="#6B7280">smallint unsigned</font></td></tr><tr><td align="left" port="expires_at">expires_at *</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="consumed_at">consumed_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="ip_address">ip_address</td><td align="left"><font color="#6B7280">varchar(45)</font></td></tr><tr><td align="left" port="created_at">created_at *</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
"auth_events" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>auth_events</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="user_id"><i>FK user_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="session_id">session_id</td><td align="left"><font color="#6B7280">char(36)</font></td></tr><tr><td align="left" port="event">event *</td><td align="left"><font color="#6B7280">varchar(40)</font></td></tr><tr><td align="left" port="identifier_hash">identifier_hash</td><td align="left"><font color="#6B7280">varchar(64)</font></td></tr><tr><td align="left" port="ip_address">ip_address</td><td align="left"><font color="#6B7280">varchar(45)</font></td></tr><tr><td align="left" port="user_agent">user_agent</td><td align="left"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="metadata">metadata</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="created_at">created_at *</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
}
"users" -> "auth_events":"user_id" [label="user_id", fontsize=8, fontcolor="#6B7280"];
"contexts" -> "user_sessions":"active_context_id" [label="active_context_id", fontsize=8, fontcolor="#6B7280"];
"access_scopes" -> "user_sessions":"active_scope_id" [label="active_scope_id", fontsize=8, fontcolor="#6B7280"];
"personal_access_tokens":"id" -> "user_sessions":"personal_access_token_id" [label="personal_access_token_id", fontsize=8, fontcolor="#6B7280"];
"users" -> "user_sessions":"user_id" [label="user_id", fontsize=8, fontcolor="#6B7280"];
"users" -> "verification_codes":"user_id" [label="user_id", fontsize=8, fontcolor="#6B7280"];
"access_scopes" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#6B7280"><font color="white"><b>access_scopes</b></font></td></tr></table>>];
"contexts" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#6B7280"><font color="white"><b>contexts</b></font></td></tr></table>>];
"users" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#6B7280"><font color="white"><b>users</b></font></td></tr></table>>];
}