digraph ERD {
graph [rankdir=LR, newrank=true, splines=true, nodesep=0.4, ranksep=0.8, fontname="Helvetica", fontsize=18, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [color="#6B7280", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.0];
subgraph cluster_0 { label="ORG"; style="rounded,filled"; fillcolor="#E8F5E9"; color="#9CA3AF";
"organizations" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>organizations</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="uuid">uuid *</td><td align="left"><font color="#6B7280">char(36)</font></td></tr><tr><td align="left" port="name">name *</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="slug">slug *</td><td align="left"><font color="#6B7280">varchar(150)</font></td></tr><tr><td align="left" port="type">type *</td><td align="left"><font color="#6B7280">varchar(30)</font></td></tr><tr><td align="left" port="status">status *</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="country_id"><i>FK country_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="region_id"><i>FK region_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="registration_number">registration_number</td><td align="left"><font color="#6B7280">varchar(100)</font></td></tr><tr><td align="left" port="email">email</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="phone">phone</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="website">website</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="address">address</td><td align="left"><font color="#6B7280">text</font></td></tr><tr><td align="left" port="logo_path">logo_path</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="settings">settings *</td><td align="left"><font color="#6B7280">json</font></td></tr><tr><td align="left" port="external_source">external_source</td><td align="left"><font color="#6B7280">varchar(50)</font></td></tr><tr><td align="left" port="external_ref">external_ref</td><td align="left"><font color="#6B7280">varchar(150)</font></td></tr><tr><td align="left" port="verified_at">verified_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="verified_by"><font color="#9CA3AF">FK verified_by</font></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="created_by"><font color="#9CA3AF">FK created_by</font></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="deleted_at">deleted_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
"organization_memberships" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>organization_memberships</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="organization_id"><i>FK organization_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="user_id"><i>FK user_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="membership_type">membership_type *</td><td align="left"><font color="#6B7280">varchar(30)</font></td></tr><tr><td align="left" port="status">status *</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="title">title</td><td align="left"><font color="#6B7280">varchar(150)</font></td></tr><tr><td align="left" port="joined_at">joined_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="left_at">left_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="added_by"><font color="#9CA3AF">FK added_by</font></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
"organization_invitations" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#1F2937"><font color="white"><b>organization_invitations</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="organization_id"><i>FK organization_id</i> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="email">email</td><td align="left"><font color="#6B7280">varchar(255)</font></td></tr><tr><td align="left" port="phone">phone</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="membership_type">membership_type *</td><td align="left"><font color="#6B7280">varchar(30)</font></td></tr><tr><td align="left" port="role_id"><i>FK role_id</i></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="token_hash">token_hash *</td><td align="left"><font color="#6B7280">varchar(64)</font></td></tr><tr><td align="left" port="status">status *</td><td align="left"><font color="#6B7280">varchar(20)</font></td></tr><tr><td align="left" port="invited_by"><font color="#9CA3AF">FK invited_by</font> *</td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="accepted_by"><font color="#9CA3AF">FK accepted_by</font></td><td align="left"><font color="#6B7280">bigint unsigned</font></td></tr><tr><td align="left" port="expires_at">expires_at *</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="accepted_at">accepted_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#6B7280">timestamp</font></td></tr></table>>];
}
"organizations":"id" -> "organization_invitations":"organization_id" [label="organization_id", fontsize=8, fontcolor="#6B7280"];
"roles" -> "organization_invitations":"role_id" [label="role_id", fontsize=8, fontcolor="#6B7280"];
"organizations":"id" -> "organization_memberships":"organization_id" [label="organization_id", fontsize=8, fontcolor="#6B7280"];
"users" -> "organization_memberships":"user_id" [label="user_id", fontsize=8, fontcolor="#6B7280"];
