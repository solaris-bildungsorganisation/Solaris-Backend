{
    "openapi": "3.0.0",
    "info": {
        "title": "Solaris Backend API",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api"
        }
    ],
    "paths": {
        "/v1/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "تسجيل الدخول وإصدار Sanctum token",
                "operationId": "6e8347b05c722875c14017197c9085d9",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "identifier",
                                    "password"
                                ],
                                "properties": {
                                    "identifier": {
                                        "description": "البريد الإلكتروني أو رقم الهاتف",
                                        "type": "string",
                                        "example": "user@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "نجاح؛ تشمل الاستجابة access_token"
                    },
                    "401": {
                        "description": "بيانات الدخول غير صحيحة"
                    },
                    "403": {
                        "description": "الحساب غير نشط"
                    },
                    "422": {
                        "description": "فشل التحقق من المدخلات"
                    }
                }
            }
        },
        "/v1/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "إلغاء التوكن الحالي وتسجيل الخروج",
                "operationId": "e32ffcabd8c7c4d859debc78ba0bae87",
                "responses": {
                    "200": {
                        "description": "تم إلغاء التوكن"
                    },
                    "401": {
                        "description": "التوكن مفقود أو غير صالح"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/v1/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "إنشاء حساب جديد",
                "description": "Handle the incoming request.",
                "operationId": "f89ab79dd86bdbaf53e6d140894d8298",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "first_name",
                                    "last_name",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "first_name": {
                                        "type": "string",
                                        "example": "أحمد"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "example": "محمد"
                                    },
                                    "display_name": {
                                        "type": "string",
                                        "example": "Ahmed M",
                                        "nullable": true
                                    },
                                    "email": {
                                        "description": "أرسل البريد أو الهاتف؛ يجب توفير أحدهما",
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@example.com",
                                        "nullable": true
                                    },
                                    "phone": {
                                        "description": "أرسل الهاتف أو البريد؛ يجب توفير أحدهما",
                                        "type": "string",
                                        "example": "+963912345678",
                                        "nullable": true
                                    },
                                    "account_type": {
                                        "description": "اختياري؛ إذا لم يُرسل يُستخدم academic_student",
                                        "type": "string",
                                        "example": "academic_student",
                                        "nullable": true
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "StrongPassword123!"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "StrongPassword123!"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "تم إنشاء الحساب"
                    },
                    "422": {
                        "description": "فشل التحقق من المدخلات أو البريد/الهاتف مستخدم مسبقًا"
                    }
                }
            }
        },
        "/v1/me/permissions": {
            "get": {
                "tags": [
                    "Me"
                ],
                "summary": "صلاحياتي الفعلية في السياق والنطاق الفعّالين",
                "description": "الصلاحيات الفعلية = أدوار النطاق العام ∪ أدوار النطاق الفعّال، مفلترة بالسياق الفعّال (الصلاحيات الذاتية تسري دائمًا). mfa_required: الصلاحيات التي تتطلب MFA (في وضع warn تُسمح مع تسجيل تحذير — القرار D8).",
                "operationId": "a703339c39ffa2c242f5ae1f8f580df5",
                "responses": {
                    "200": {
                        "description": "نجاح",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "data": {
                                        "context": {
                                            "id": 11,
                                            "key": "administration"
                                        },
                                        "scope": {
                                            "id": 1,
                                            "type": "global",
                                            "country_id": null,
                                            "region_id": null,
                                            "organization_uuid": null
                                        },
                                        "is_super_admin": false,
                                        "roles": [
                                            {
                                                "name": "platform_admin",
                                                "rank": 90,
                                                "scope_id": 1,
                                                "scope_type": "global",
                                                "counted": true,
                                                "expires_at": null
                                            },
                                            {
                                                "name": "learner",
                                                "rank": 10,
                                                "scope_id": 1,
                                                "scope_type": "global",
                                                "counted": false,
                                                "expires_at": null
                                            }
                                        ],
                                        "permissions": [
                                            "dashboard.view",
                                            "profile.view_own",
                                            "users.update_status",
                                            "users.view",
                                            "users.view_any"
                                        ],
                                        "mfa_required": [
                                            "users.update_status"
                                        ],
                                        "mfa": {
                                            "mode": "warn",
                                            "confirmed": false
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "التوكن مفقود أو غير صالح"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/v1/me/scopes": {
            "get": {
                "tags": [
                    "Me"
                ],
                "summary": "النطاقات التي أملك فيها أدوارًا (للاختيار منها)",
                "operationId": "bd76dbecf1aa3f1f5e0232702eecd496",
                "responses": {
                    "200": {
                        "description": "قائمة النطاقات؛ النطاق العام دائمًا موجود، و active يحدد الفعّال حاليًا"
                    },
                    "401": {
                        "description": "التوكن مفقود أو غير صالح"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/v1/me/scope": {
            "post": {
                "tags": [
                    "Me"
                ],
                "summary": "تفعيل نطاق للجلسة الحالية",
                "operationId": "9232d36176fb8c735a7c7a82545cfa94",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "scope_id"
                                ],
                                "properties": {
                                    "scope_id": {
                                        "type": "integer",
                                        "example": 4
                                    },
                                    "context": {
                                        "description": "اختياري: تفعيل سياق من سياقاتي النشطة مع النطاق (دمج مع تبديل السياق — ورقة B4)",
                                        "type": "string",
                                        "example": "organization",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "تم التفعيل؛ الاستجابة = صلاحياتي في النطاق الجديد (مثل GET /me/permissions)"
                    },
                    "409": {
                        "description": "التوكن غير مرتبط بجلسة"
                    },
                    "422": {
                        "description": "نطاق أو سياق غير متاح لك"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "Sanctum Personal Access Token",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Me",
            "description": "Me"
        }
    ]
}