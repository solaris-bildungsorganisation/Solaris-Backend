{
    "openapi": "3.0.0",
    "info": {
        "title": "Solaris Backend API",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api"
        }
    ],
    "paths": {
        "/v1/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "تسجيل الدخول وإصدار Sanctum token",
                "operationId": "6e8347b05c722875c14017197c9085d9",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "identifier",
                                    "password"
                                ],
                                "properties": {
                                    "identifier": {
                                        "description": "البريد الإلكتروني أو رقم الهاتف",
                                        "type": "string",
                                        "example": "user@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "نجاح؛ تشمل الاستجابة access_token"
                    },
                    "401": {
                        "description": "بيانات الدخول غير صحيحة"
                    },
                    "403": {
                        "description": "الحساب غير نشط"
                    },
                    "422": {
                        "description": "فشل التحقق من المدخلات"
                    }
                }
            }
        },
        "/v1/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "إلغاء التوكن الحالي وتسجيل الخروج",
                "operationId": "e32ffcabd8c7c4d859debc78ba0bae87",
                "responses": {
                    "200": {
                        "description": "تم إلغاء التوكن"
                    },
                    "401": {
                        "description": "التوكن مفقود أو غير صالح"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/v1/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "إنشاء حساب جديد",
                "description": "Handle the incoming request.",
                "operationId": "f89ab79dd86bdbaf53e6d140894d8298",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "first_name",
                                    "last_name",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "first_name": {
                                        "type": "string",
                                        "example": "أحمد"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "example": "محمد"
                                    },
                                    "display_name": {
                                        "type": "string",
                                        "example": "Ahmed M",
                                        "nullable": true
                                    },
                                    "email": {
                                        "description": "أرسل البريد أو الهاتف؛ يجب توفير أحدهما",
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@example.com",
                                        "nullable": true
                                    },
                                    "phone": {
                                        "description": "أرسل الهاتف أو البريد؛ يجب توفير أحدهما",
                                        "type": "string",
                                        "example": "+963912345678",
                                        "nullable": true
                                    },
                                    "account_type": {
                                        "description": "اختياري؛ إذا لم يُرسل يُستخدم academic_student",
                                        "type": "string",
                                        "example": "academic_student",
                                        "nullable": true
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "StrongPassword123!"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "StrongPassword123!"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "تم إنشاء الحساب"
                    },
                    "422": {
                        "description": "فشل التحقق من المدخلات أو البريد/الهاتف مستخدم مسبقًا"
                    }
                }
            }
        },
        "/v1/me/account-type-requests": {
            "get": {
                "tags": [
                    "Profile - Account Type Requests"
                ],
                "summary": "عرض طلبات المستخدم الحالية وحالتها",
                "description": "يعرض قائمة بطلبات أنواع الحسابات الخاصة بالمستخدم الحالي مع حالتها.",
                "operationId": "b2ac2ece51bd2c75f449a53221ae476c",
                "responses": {
                    "200": {
                        "description": "تم جلب الطلبات بنجاح"
                    },
                    "401": {
                        "description": "غير مصرح"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/v1/me/account-type-requests/{uuid}": {
            "delete": {
                "tags": [
                    "Profile - Account Type Requests"
                ],
                "summary": "إلغاء طلب ما زال pending فقط",
                "description": "إلغاء طلب نوع الحساب بشرط أن يكون ما زال في حالة pending.",
                "operationId": "5f85cc5d32db955d27b3d0ad53ab52c1",
                "parameters": [
                    {
                        "name": "uuid",
                        "in": "path",
                        "description": "UUID الخاص بالطلب",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "تم إلغاء الطلب بنجاح"
                    },
                    "422": {
                        "description": "لا يمكن إلغاء الطلب لأنه لم يعد في حالة pending"
                    },
                    "404": {
                        "description": "الطلب غير موجود أو لا يخص المستخدم"
                    },
                    "401": {
                        "description": "غير مصرح"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/v1/me/languages": {
            "get": {
                "tags": [
                    "Profile - Languages"
                ],
                "summary": "عرض لغات المستخدم",
                "description": "يعرض اللغات ومستويات إتقان المستخدم الحالي.",
                "operationId": "02c951d01454a2f20b08dea69b6b9637",
                "responses": {
                    "200": {
                        "description": "تم جلب لغات المستخدم بنجاح"
                    },
                    "401": {
                        "description": "غير مصرح"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Profile - Languages"
                ],
                "summary": "إضافة لغة للمستخدم",
                "description": "Store a newly created resource in storage.",
                "operationId": "f7ed220aef9a0da22ca472ecdd3a0f60",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "language_id",
                                    "proficiency"
                                ],
                                "properties": {
                                    "language_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "proficiency": {
                                        "type": "string",
                                        "example": "B2",
                                        "enum": [
                                            "A1",
                                            "A2",
                                            "B1",
                                            "B2",
                                            "C1",
                                            "C2",
                                            "native"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "تمت إضافة اللغة بنجاح"
                    },
                    "401": {
                        "description": "غير مصرح"
                    },
                    "422": {
                        "description": "فشل التحقق أو اللغة مضافة مسبقاً"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/v1/me/languages/{userLanguage}": {
            "delete": {
                "tags": [
                    "Profile - Languages"
                ],
                "summary": "حذف لغة من ملف المستخدم",
                "description": "Remove the specified resource from storage.",
                "operationId": "2cc2ea00f0dfdc5e3ed45d114adfc621",
                "parameters": [
                    {
                        "name": "userLanguage",
                        "in": "path",
                        "description": "معرّف سجل لغة المستخدم",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "تم حذف اللغة بنجاح"
                    },
                    "401": {
                        "description": "غير مصرح"
                    },
                    "403": {
                        "description": "لا يمكن حذف لغة تم التحقق منها"
                    },
                    "404": {
                        "description": "سجل اللغة غير موجود"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "patch": {
                "tags": [
                    "Profile - Languages"
                ],
                "summary": "تعديل مستوى إتقان اللغة",
                "description": "Update the specified resource in storage.",
                "operationId": "76937bd59824d87698c52bf4087ab396",
                "parameters": [
                    {
                        "name": "userLanguage",
                        "in": "path",
                        "description": "معرّف سجل لغة المستخدم",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "proficiency": {
                                        "type": "string",
                                        "example": "C1",
                                        "enum": [
                                            "A1",
                                            "A2",
                                            "B1",
                                            "B2",
                                            "C1",
                                            "C2",
                                            "native"
                                        ]
                                    },
                                    "is_native": {
                                        "type": "boolean",
                                        "example": false
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "تم تحديث اللغة بنجاح"
                    },
                    "401": {
                        "description": "غير مصرح"
                    },
                    "403": {
                        "description": "لا يمكن تعديل لغة تم التحقق منها"
                    },
                    "404": {
                        "description": "سجل اللغة غير موجود"
                    },
                    "422": {
                        "description": "فشل التحقق من المدخلات"
        "/v1/me/permissions": {
            "get": {
                "tags": [
                    "Me"
                ],
                "summary": "صلاحياتي الفعلية في السياق والنطاق الفعّالين",
                "description": "الصلاحيات الفعلية = أدوار النطاق العام ∪ أدوار النطاق الفعّال، مفلترة بالسياق الفعّال (الصلاحيات الذاتية تسري دائمًا). mfa_required: الصلاحيات التي تتطلب MFA (في وضع warn تُسمح مع تسجيل تحذير — القرار D8).",
                "operationId": "a703339c39ffa2c242f5ae1f8f580df5",
                "responses": {
                    "200": {
                        "description": "نجاح",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "data": {
                                        "context": {
                                            "id": 11,
                                            "key": "administration"
                                        },
                                        "scope": {
                                            "id": 1,
                                            "type": "global",
                                            "country_id": null,
                                            "region_id": null,
                                            "organization_uuid": null
                                        },
                                        "is_super_admin": false,
                                        "roles": [
                                            {
                                                "name": "platform_admin",
                                                "rank": 90,
                                                "scope_id": 1,
                                                "scope_type": "global",
                                                "counted": true,
                                                "expires_at": null
                                            },
                                            {
                                                "name": "learner",
                                                "rank": 10,
                                                "scope_id": 1,
                                                "scope_type": "global",
                                                "counted": false,
                                                "expires_at": null
                                            }
                                        ],
                                        "permissions": [
                                            "dashboard.view",
                                            "profile.view_own",
                                            "users.update_status",
                                            "users.view",
                                            "users.view_any"
                                        ],
                                        "mfa_required": [
                                            "users.update_status"
                                        ],
                                        "mfa": {
                                            "mode": "warn",
                                            "confirmed": false
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "التوكن مفقود أو غير صالح"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/v1/me": {
            "get": {
