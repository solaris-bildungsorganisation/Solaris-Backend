        },
        "/v1/me/avatar": {
            "post": {
                "tags": [
                    "Profile"
                ],
                "summary": "رفع الصورة الشخصية",
                "description": "POST /me/avatar\nرفع الصورة الشخصية.",
                "operationId": "565dce30adcb83a471c0f6f3178a91d3",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "avatar"
                                ],
                                "properties": {
                                    "avatar": {
                                        "description": "صورة JPG أو PNG أو WEBP، بحد أقصى 2MB",
                                        "type": "string",
                                        "format": "binary"
        "/v1/me/scope": {
            "post": {
                "tags": [
                    "Me"
                ],
                "summary": "تفعيل نطاق للجلسة الحالية",
                "operationId": "9232d36176fb8c735a7c7a82545cfa94",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "scope_id"
                                ],
                                "properties": {
                                    "scope_id": {
                                        "type": "integer",
                                        "example": 4
                                    },
                                    "context": {
                                        "description": "اختياري: تفعيل سياق من سياقاتي النشطة مع النطاق (دمج مع تبديل السياق — ورقة B4)",
                                        "type": "string",
                                        "example": "organization",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "تم رفع الصورة بنجاح"
                    },
                    "401": {
                        "description": "غير مصرح"
                    },
                    "422": {
                        "description": "الصورة غير صالحة أو تجاوزت الحجم المسموح"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Profile"
                ],
                "summary": "حذف الصورة الشخصية",
                "description": "DELETE /me/avatar\nحذف الصورة الشخصية.",
                "operationId": "0793a924948c0c60ac1a0e68ec3597de",
                "responses": {
                    "200": {
                        "description": "تم حذف الصورة الشخصية بنجاح"
                    },
                    "401": {
                        "description": "غير مصرح"
                        "description": "تم التفعيل؛ الاستجابة = صلاحياتي في النطاق الجديد (مثل GET /me/permissions)"
                    },
                    "409": {
                        "description": "التوكن غير مرتبط بجلسة"
                    },
                    "422": {
                        "description": "نطاق أو سياق غير متاح لك"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
